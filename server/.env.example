# EduProctor AI Production Environment Configuration
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://mongodb:27017/eduproctor
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_cryptographically_secure_256_bit_secret
# Comma-separated allowed frontend origins for CORS
CORS_ORIGIN=https://exams.university.edu,https://eduproctor.ai
# Optional Redis URL for multi-instance horizontal scaling
# REDIS_URL=redis://redis:6379
